# Gmail API credentials
# Follow: https://developers.google.com/gmail/api/quickstart/python
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_SENDER_EMAIL=your-email@gmail.com

# Gong API credentials
# Get from: https://app.gong.io/company/api
GONG_API_BASE_URL=https://us-11211.api.gong.io
GONG_ACCESS_KEY=your-gong-access-key
GONG_ACCESS_KEY_SECRET=your-gong-access-key-secret

# Nurture campaign settings
NURTURE_CHECK_INTERVAL_HOURS=24
NURTURE_DAYS_BEFORE_CLOSE=90
NURTURE_EMAIL_INTERVAL_DAYS=7

# Database
DATABASE_URL=sqlite+aiosqlite:///./sales_pipeline.db
